# Google Gemini API key — server-side only
GOOGLE_AI_API_KEY=

# Shared secret between client and API — pseudo-secret for bot/scrape defense.
# Client bundles NEXT_PUBLIC_APP_SHARED_SECRET; server verifies APP_SHARED_SECRET.
# They must match. Rotate occasionally. This is NOT real auth — clients can extract it.
APP_SHARED_SECRET=
NEXT_PUBLIC_APP_SHARED_SECRET=

# Comma-separated list of allowed Origin/Referer prefixes for API routes
# e.g. https://lifebuilder.app,capacitor://localhost,http://localhost:3000
ALLOWED_ORIGINS=
